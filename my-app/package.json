{
  "name": "my-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others \"npm run server\" \"npm run proxy\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "tslint --project tsconfig.json",
    "proxy": "ng serve --port 7777 --proxy-config proxy.conf.json",
    "server": "json-server --watch db.json"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "~17.0.1",
    "@angular/animations": "17.3.7",
    "@angular/cdk": "17.3.7",
    "@angular/common": "17.3.7",
    "@angular/compiler": "17.3.7",
    "@angular/core": "17.3.7",
    "@angular/elements": "17.3.7",
    "@angular/forms": "17.3.7",
    "@angular/platform-browser": "17.3.7",
    "@angular/platform-browser-dynamic": "17.3.7",
    "@angular/router": "17.3.7",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/schematics": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "@ngrx/store-devtools": "^17.2.0",
    "concurrently": "^9.1.2",
    "json-server": "0.17.0",
    "primeflex": "^3.0.0",
    "primeicons": "~6.0.1",
    "primeng": "^17.16.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.3.7",
    "@angular-devkit/schematics": "17.3.7",
    "@angular/cli": "17.3.7",
    "@angular/compiler-cli": "17.3.7",
    "@types/jasmine": "~4.3.6",
    "jasmine-core": "~4.6.1",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.3.3"
  }
